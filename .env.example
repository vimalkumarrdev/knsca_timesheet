# Copy this file to .env and fill in real values before running docker compose up.
# .env is gitignored — never commit real secrets.

# Django
SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (used by both the web and db services)
DB_NAME=knsca_timesheet
DB_USER=knsca
DB_PASSWORD=replace-with-a-strong-password
DB_ROOT_PASSWORD=replace-with-a-strong-root-password

# Email (leave EMAIL_BACKEND unset locally to print emails to the console instead of sending)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-sender-address
EMAIL_HOST_PASSWORD=replace-with-smtp-password-or-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=KNSCA Timesheet <noreply@knsca.in>

# Used to build absolute links inside reminder emails
SITE_URL=https://your-real-domain.example

# HTTPS hardening — leave all of these False/0 until nginx + a real TLS cert are
# confirmed working in front of the app, then flip them on (see nginx/README.md).
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
CSRF_TRUSTED_ORIGINS=https://your-real-domain.example
